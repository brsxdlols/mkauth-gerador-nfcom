    2ª Etapa de Validação NFCom (Final)
  </button>

  <button type="button" id="forcar_validacao_marcadas" 
          class="btn btn-warning btn-sm shadow-sm px-3 py-2">
    <i class="bi bi-lightning-charge-fill"></i>
    3ª Etapa Forçar Validação das NFCom Marcadas
  </button>

</div>

<script>
document.getElementById('forcar_validacao_marcadas').addEventListener('click', function() {
    const marcados = document.querySelectorAll('input.boxnfe:checked');
    if (marcados.length === 0) return alert('Nenhuma NFCom marcada!');

    if (!confirm(`Forçar validação em ${marcados.length} NFCom(s) marcada(s)?\n\nIsso pode levar alguns minutos.`)) return;

    const overlay = document.createElement('div');
    overlay.id = 'loading-overlay';
    overlay.innerHTML = `
        <div style="position:fixed;top:0;left:0;width:100vw;height:100vh;background:rgba(0,0,0,0.8);z-index:9999;display:flex;align-items:center;justify-content:center;flex-direction:column;color:white;backdrop-filter:blur(6px);">
            <i class="bi bi-hourglass-split" style="font-size:90px;animation:pulse 1.8s infinite;"></i>
            <h2 style="margin-top:20px;margin-bottom:10px;">Enviando para Sefaz...</h2>
            <p style="font-size:19px;" id="contador-processando">
                Processando <span id="atual">0</span> de <strong>${marcados.length}</strong>
            </p>
            <p style="margin-top:25px;opacity:0.9;">Aguarde • Não feche ou atualize a página</p>
        </div>`;
    document.body.appendChild(overlay);

    document.head.insertAdjacentHTML('beforeend', `
        <style>
            @keyframes pulse {
                0%,100% { transform:scale(1); }
                50% { transform:scale(1.15); }
            }
        </style>`);

    let processadas = 0;
    const total = marcados.length;
    const contador = document.getElementById('atual');
    const container = document.createElement('div');
    container.style.display = 'none';
    document.body.appendChild(container);

    const uuidsProcessados = new Set();
    marcados.forEach(cb => uuidsProcessados.add(cb.value));

    marcados.forEach((checkbox, index) => {
        setTimeout(() => {
            const iframe = document.createElement('iframe');
            iframe.src = '../../nfcom_info.hhvm?uuid=' + checkbox.value + '&t=' + Date.now();
            iframe.style.display = 'none';

            iframe.onload = iframe.onerror = () => {
                processadas++;
                contador.textContent = processadas;

                setTimeout(() => iframe.remove(), 1000);

                if (processadas === total) {
                                 setTimeout(() => {
                        overlay.remove();
                        container.remove();
                        let concluidas = 0;
                        document.querySelectorAll('#lista tbody tr').forEach(row => {
                            const checkBox = row.querySelector('input.boxnfe');
                            if (checkBox && uuidsProcessados.has(checkBox.value)) {
                                const statusCell = row.querySelector('td:nth-child(8)'); 
                                if (statusCell && statusCell.textContent.includes('CONCLUÍDO')) {
                                    concluidas++;
                                }
                            }
                        });

                        const rejeitadasOuPendentes = total - concluidas;

                        alert(
                            `PRONTO! Validação finalizada.\n\n` +
                            `Concluídas: ${concluidas}\n` +
                            `Rejeitadas ou ainda pendentes: ${rejeitadasOuPendentes}\n\n` +
                            `Total processado: ${total}\n\n` +
                            `Atualize a página em 3-5 segundos para ver tudo certinho.`
                        );
                    }, 2000); 
                }
            };

            container.appendChild(iframe);
        }, index * 750);
    });
});
</script>

<script>
document.getElementById('reprocessar_popup').addEventListener('click', function() {
    let marcados = document.querySelectorAll("input[name^='nfcom[']:checked").length;
    
    if (marcados === 0) {
        alert('Selecione pelo menos uma NFCom para reprocessar!');
        return;
    }

    let hidden = document.createElement('input');
    hidden.type = 'hidden';
    hidden.name = 'gerar_nfe';
    hidden.value = '1';

    let popup = window.open('', 'ReprocessarNFCom2025', 
        'width=795,height=680,left=100,top=100,scrollbars=yes,resizable=yes');

    if (!popup) {
        alert('Popup bloqueado! Permita popups para este site.');
        return;
    }

    popup.focus();

    let form = document.querySelector('form[action="../../nfcom_processar.hhvm"]');
    form.appendChild(hidden);
    form.target = 'ReprocessarNFCom2025';
    form.submit();
});
</script>


</div>
</form>
