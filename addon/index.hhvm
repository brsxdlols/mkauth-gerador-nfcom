<script>
document.getElementById('gerar_nfe_popup').addEventListener('click', function() {
    let marcados = document.querySelectorAll(\"input[name^='titulo[']:checked\").length;
    if (marcados === 0) {
        alert('Selecione pelo menos um cliente para gerar a NFE!');
        return;
    }

    let hidden = document.createElement('input');
    hidden.type = 'hidden';
    hidden.name = 'gerar_nfe';
    hidden.value = '1';
    let popup = window.open('', 'NFE2025', 'width=795,height=680,left=10,top=10,scrollbars=yes,resizable=yes');
    popup.focus();

    let form = document.getElementById('form_nfe');
    form.appendChild(hidden);
    form.target = 'NFE2025';
    form.submit();
});
</script>
