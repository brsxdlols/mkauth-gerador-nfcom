$total_listados = 0;


while ($row = mysqli_fetch_array($result)) {
    $total_listados++;
    $t_tit_id = $row['id'];
    $c_login = $row['login'];
    $c_nome = $row['nome'];
    $uuid_cliente = $row['uuid_cliente'];
    $c_nome_res = $row['nome_res'];
    $c_bloq = $row['bloqueado'];
    $c_cadastro = $row['cadastro'];
    $t_vencimento   = date('d/m/Y', strtotime($row['datavenc']));


        $id_titulo      = $row['id'];  
        $valor_boleto   = (float)$row['valor'];
        $valor_extra    = $servicos_avulsos[$id_titulo] ?? 0;
        $valor_final    = $valor_boleto + $valor_extra;
        $t_valor        = number_format($valor_final, 2, ',', '.');

        $t_valorpag     = number_format($row['valorpag'], 2, ',', '.');
        $t_status       = $row['status'];

    switch(strtolower($t_status)) {
        case 'pago':
            $status_html = "<span class='text-success font-weight-bold'>PAGO</span>";
            break;
        case 'aberto':
            $status_html = "<span class='text-primary font-weight-bold'>ABERTO</span>";
            break;
        default:
            $status_html = "<span class='text-danger font-weight-bold'>$t_status</span>";
            break;
    }

if (strtolower($t_status) !== 'pago') {
    $valor_html = "<span style='background:#cfe2ff; color:#0d6efd; font-weight:600; padding:3px 10px; border-radius:8px;'>R$ $t_valor</span>";
    $valorpag_html = "<span style='background:#cfe2ff; color:#0d6efd; font-weight:600; padding:3px 10px; border-radius:8px;'>⏳ A receber</span>";
} else {
    $valor_html = "<span style='background:#cfe2ff; color:#0d6efd; font-weight:600; padding:3px 10px; border-radius:8px;'>R$ $t_valor</span>";
    $valorpag_html = "<span style='background:#d1e7dd; color:#0f5132; font-weight:600; padding:3px 10px; border-radius:8px;'>R$ $t_valorpag</span>";
}




 
$query_uuid = mysqli_query($link, "SELECT uuid_lanc FROM sis_lanc WHERE id = '$t_tit_id' LIMIT 1");
$uuid_lanc = '';
if ($query_uuid && mysqli_num_rows($query_uuid) > 0) {
    $dados_uuid = mysqli_fetch_assoc($query_uuid);
    $uuid_lanc = $dados_uuid['uuid_lanc'];
}


$nfcom_status = null;
if ($uuid_lanc != '') {
    $query_nfcom = mysqli_query($link, "SELECT status, emissao FROM sis_nfcom WHERE titulo = '$uuid_lanc' LIMIT 1");
    if ($query_nfcom && mysqli_num_rows($query_nfcom) > 0) {
        $dados_nfcom = mysqli_fetch_assoc($query_nfcom);
        $nfcom_status = strtoupper(trim($dados_nfcom['status']));
        $nfcom_emissao = date('d/m/Y', strtotime($dados_nfcom['emissao']));
    }
}

if ($nfcom_status === 'CONCLUIDO') {
    continue;
}

if ($nfcom_status) {
    switch ($nfcom_status) {
        case 'PROCESSANDO':
        case 'EM PROCESSO':
            $nfe_login = "<span class='text-warning font-weight-bold'>⏳ EM PROCESSO</span><br><small class='text-muted'>Emissão: $nfcom_emissao</small>";
            break;
        case 'ERRO':
        case 'REJEITADO':
            $nfe_login = "<span class='text-danger font-weight-bold'>❌ ERRO / REJEITADO</span><br><small class='text-muted'>Emissão: $nfcom_emissao</small>";
            break;
        default:
            $nfe_login = "<span class='text-secondary font-weight-bold'>$nfcom_status</span><br><small class='text-muted'>Emissão: $nfcom_emissao</small>";
            break;
    }

    $linha_checkbox = "<td><input type='checkbox' class='boxnfe' name='titulo[$t_tit_id]' value='$t_tit_id'></td>";
    $classe_linha = "bg-light";
} else {
    $nfe_login = "<span class='text-danger font-weight-bold'>❌ NÃO GERADA</span>";
    $linha_checkbox = "<td><input type='checkbox' class='checkbox' name='titulo[$t_tit_id]' value='$t_tit_id'></td>";
    $classe_linha = ($c_bloq == 'sim') ? 'table-danger' : '';
}


    $linha[$c_login] = "
    <tr class='$classe_linha'>
        $linha_checkbox       
          <td>
    <strong>$c_nome</strong><br>
    <span style='font-size:11px; color:#444;'>$c_nome_res</span><br>
    <span style='font-size:11px; color:#444;'>$c_login</span>   
    <div style='margin-top:4px; font-size:12px;'>
      <a href='/admin/cliente_det.hhvm?uuid=" . urlencode($uuid_cliente) . "' 
         style='color:#000; text-decoration:none;'>
         <i class='bi bi-cash-stack'></i> Detalhes
      </a>

      &nbsp;|&nbsp;

      <a href='/admin/cliente_alt.hhvm?uuid=" . urlencode($uuid_cliente) . "' 
         style='color:#000; text-decoration:none;'>
         <i class='fa fa-edit'></i> Alterar
      </a>
    </div> 
        </td>
        <td>$c_cadastro</td>
        <td>$t_tit_id</td>
        <td>$t_vencimento</td>
        <td>$valor_html</td>
        <td>$valorpag_html</td>
        <td>$status_html</td>
        <td>$nfe_login</td>
    </tr>";






if ($status_cap === '%' || strtolower($t_status) === $status_cap) {
    echo $linha[$c_login];
}
}

echo "
