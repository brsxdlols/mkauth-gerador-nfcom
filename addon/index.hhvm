            $('.checkbox').each(function() {
                this.checked = true;
            });
            $('.boxnfe').each(function() {
                this.checked = true;
            });
        } else {
            $('.checkbox').each(function() {
                this.checked = false;
            });
            $('.boxnfe').each(function() {
                this.checked = false;
            });
        }
    });

    $('#allnfe').click(function(event) {
        if (this.checked) {
            $('.boxnfe').each(function() {
                this.checked = true;
            });
        } else {
            $('.boxnfe').each(function() {
                this.checked = false;
            });
        }
    });
});
</script>

