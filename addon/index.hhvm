<?php
$busca      = $_GET['busca'] ?? '';
$mes_get    = $_GET['mes']  ?? date('m');
$ano_get    = $_GET['ano']  ?? date('Y');
$status_cap = $_GET['status'] ?? '%';

$mes_get = str_pad($mes_get, 2, '0', STR_PAD_LEFT);

$data_inicial     = "$ano_get-$mes_get-01";
$data_final       = date('Y-m-t', strtotime($data_inicial));
$data_inicial_sql = $data_inicial;
$data_final_sql   = $data_final;
$servicos_avulsos = [];
$q_mlanc = mysqli_query($link, "SELECT idlanc, tipo, SUM(valor) AS total_valor FROM sis_mlanc GROUP BY idlanc, tipo");
if ($q_mlanc && mysqli_num_rows($q_mlanc) > 0) {
    while ($m = mysqli_fetch_assoc($q_mlanc)) {
        $idlanc = $m['idlanc'];
        $valor  = (float)$m['total_valor'];
        $tipo   = strtolower(trim($m['tipo']));
        if (!isset($servicos_avulsos[$idlanc])) $servicos_avulsos[$idlanc] = 0;
        if ($tipo === 'desconto') {
            $servicos_avulsos[$idlanc] -= $valor;
        } else {
            $servicos_avulsos[$idlanc] += $valor;
        }
    }
}

$ano = $ano_get;
$mes = $mes_get;
$ref = substr($ano, 2, 2) . $mes;


$query = "
SELECT 
    t.id, 
    t.login, 
    t.datavenc,
    t.valor, 
    t.valorpag, 
    t.status, 
    c.nome,
    c.nome_res, 
    c.cadastro,
    c.uuid_cliente, 
    c.bloqueado    
FROM sis_lanc t
LEFT JOIN sis_cliente c ON t.login = c.login
WHERE 
(
    c.nome LIKE '%$busca%' OR
    c.login LIKE '%$busca%' OR
    c.nome_res LIKE '%$busca%'
)
AND c.geranfe LIKE 'sim'
AND t.deltitulo = 0
AND t.datavenc BETWEEN '$data_inicial_sql' AND '$data_final_sql'
AND c.cli_ativado = 's'
AND t.status LIKE '$status_cap'
AND t.uuid_lanc NOT IN (SELECT titulo FROM sis_nfcom)  -- 🚫 ignora títulos já com NFCom
ORDER BY c.nome ASC";


$result = mysqli_query($link, $query);
$total_listados = mysqli_num_rows($result);

if (!$result) {
    echo mysqli_error($link);
}



            $query_nfe_gerada = mysqli_query($link, "SELECT id_titulo FROM sis_nfe WHERE referencia = '$ref'");
            $nfe_gerada = [];
            while ($n = mysqli_fetch_array($query_nfe_gerada)) {
                $nfe_gerada[$n['id_titulo']] = true;
            }

    if (!$result){
        echo mysqli_error($link);
    }

    

?>

<form id="filtro_auto" class="no_print">
    <div class="container mb-3">
        <div class="row g-3 align-items-end">

            <div class="col-md-3 col-6">
                <label class="form-label fw-bold">Mês:</label>
                <select name="mes" class="form-select filtro-auto">
                    <?php
                    $mes_atual = $_GET['mes'] ?? date('m');
                    $meses = ['01'=>'Janeiro','02'=>'Fevereiro','03'=>'Março','04'=>'Abril','05'=>'Maio','06'=>'Junho','07'=>'Julho','08'=>'Agosto','09'=>'Setembro','10'=>'Outubro','11'=>'Novembro','12'=>'Dezembro'];
                    foreach ($meses as $n => $nome) {
                        $sel = ($n == $mes_atual) ? 'selected' : '';
                        echo "<option value='$n' $sel>$nome</option>";
                    }
                    ?>
                </select>
            </div>

            <div class="col-md-2 col-6">
                <label class="form-label fw-bold">Ano:</label>
                <select name="ano" class="form-select filtro-auto">
                    <?php
                    $ano_atual = date('Y');
                    $ano_sel = $_GET['ano'] ?? $ano_atual;
                    for ($a = $ano_atual - 5; $a <= $ano_atual + 2; $a++) {
                        $sel = ($a == $ano_sel) ? 'selected' : '';
                        echo "<option value='$a' $sel>$a</option>";
                    }
                    ?>
                </select>
            </div>

            <div class="col-md-3 col-6">
                <label class="form-label fw-bold">Status:</label>
                <select name="status" class="form-select filtro-auto">
                    <?php
                    $status_list = ['%' => 'TODOS', 'pago' => 'PAGO', 'aberto' => 'ABERTO'];
                    foreach ($status_list as $k => $v) {
                        $sel = ($status_cap == $k) ? 'selected' : '';
                        echo "<option value='$k' $sel>$v</option>";
                    }
                    ?>
                </select>
            </div>

            <div class="col-12 mt-3">
                <div class="row g-2 align-items-center">
                    <div class="col-lg-9 col-12">
                        <input type="text" name="busca" class="form-control" 
                               placeholder="Pesquisar: Nome, Login ou Nome Resumido" 
                               value="<?php echo htmlspecialchars($busca ?? ''); ?>">
                    </div>
                    <div class="col-lg-3 col-12">
                        <button type="submit" class="btn btn-primary w-100">Pesquisar</button>
                    </div>
                </div>
            </div>

        </div>
    </div>
</form>

<script>
document.addEventListener("DOMContentLoaded", function() {
    const form = document.getElementById('filtro_auto');
    document.querySelectorAll('.filtro-auto').forEach(el => {
        el.addEventListener('change', () => {
            const temp = form.busca.value;
            const input = form.querySelector('input[name="busca"]');
            input.removeAttribute('name');
            form.submit();
            setTimeout(() => { input.name = 'busca'; input.value = temp; }, 100);
        });
    });
});
</script>

