    </div>

  </td>

  <td>$t_tit_id</td>
  <td>$t_vencimento</td>
  <td>$valor_html</td>
  <td>$valorpag_html</td>
  <td>$status_html</td>
  <td>$nfe_login<br>{$row['obs']}</td>
</tr>";


}
