<?php

$busca        = $_GET['busca'] ?? '';
$mes_get      = $_GET['mes'] ?? date('m');
$ano_get      = $_GET['ano'] ?? date('Y');
$status_cap   = $_GET['status'] ?? '%';
$status_nf    = $_GET['status_nfcom'] ?? '%';

$mes_get = str_pad($mes_get, 2, '0', STR_PAD_LEFT);

$data_inicial_sql = "$ano_get-$mes_get-01";
$data_final_sql   = date('Y-m-t', strtotime($data_inicial_sql));

$servicos_avulsos = [];
$q_mlanc = mysqli_query($link, "SELECT idlanc, tipo, SUM(valor) AS total_valor FROM sis_mlanc GROUP BY idlanc, tipo");
if ($q_mlanc && mysqli_num_rows($q_mlanc) > 0) {
    while ($m = mysqli_fetch_assoc($q_mlanc)) {
        $idlanc = $m['idlanc'];
        $valor  = (float)$m['total_valor'];
        $tipo   = strtolower(trim($m['tipo']));
        if (!isset($servicos_avulsos[$idlanc])) $servicos_avulsos[$idlanc] = 0;
        if ($tipo === 'desconto') {
            $servicos_avulsos[$idlanc] -= $valor;
        } else {
            $servicos_avulsos[$idlanc] += $valor;
        }
    }
}

$ano  = $ano_get;
$ano2 = substr($ano, 2, 2);

if ($status_nf === '%' || $status_nf === '') {
    $condicao_nfcom = "AND n.status IN ('REJEITADO', 'CANCELADO')";
} elseif ($status_nf === 'REJEITADO') {
    $condicao_nfcom = "AND n.status = 'REJEITADO'";
} elseif ($status_nf === 'CANCELADO') {
    $condicao_nfcom = "AND n.status = 'CANCELADO'";
} else {
    $condicao_nfcom = "AND n.status IN ('REJEITADO', 'CANCELADO')";
}


$lista_mes = [
    "01" => "JAN", "02" => "FEV", "03" => "MAR", "04" => "ABR",
    "05" => "MAI", "06" => "JUN", "07" => "JUL", "08" => "AGO",
    "09" => "SET", "10" => "OUT", "11" => "NOV", "12" => "DEZ"
];

$query = "
SELECT 
    l.id AS tit_id,
    l.login,
    l.datavenc,
    l.valor,
    l.valorpag,
    l.status,
    c.nome,
    c.cadastro,
    c.uuid_cliente,
    c.nome_res,
    c.bloqueado,
    n.uuid_nfcom,
    n.idmka,
    n.titulo,
    n.serie,
    n.numero,
    n.emissao,
    n.status AS nfcom_status,
    n.chave,
    n.protocolo,
    n.opcoes,
    n.itens,
    n.finalidade,
    n.obs
FROM sis_nfcom n
INNER JOIN sis_lanc l ON n.titulo = l.uuid_lanc
INNER JOIN sis_cliente c ON l.login = c.login
WHERE 
    (
        c.nome LIKE '%$busca%' 
        OR c.login LIKE '%$busca%'
        OR c.nome_res LIKE '%$busca%'
    )
    AND l.deltitulo = 0
    AND n.emissao BETWEEN '$data_inicial_sql' AND '$data_final_sql'
    AND l.status LIKE '$status_cap'
    $condicao_nfcom
ORDER BY c.nome ASC
";



$result = mysqli_query($link, $query);
if (!$result) {
    echo mysqli_error($link);
}

$total_query = "
SELECT 
    COALESCE(SUM(l.valor), 0) AS total_valor,
    COALESCE(SUM(l.valorpag), 0) AS total_valor_pago,
    COUNT(*) AS total_nfcom,
    SUM(CASE WHEN n.status = 'CANCELADO' THEN 1 ELSE 0 END) AS qtd_canceladas,
    SUM(CASE WHEN n.status = 'REJEITADO' THEN 1 ELSE 0 END) AS qtd_rejeitadas
FROM sis_nfcom n
INNER JOIN sis_lanc l ON n.titulo = l.uuid_lanc
INNER JOIN sis_cliente c ON l.login = c.login
WHERE 
    (c.nome LIKE '%$busca%' OR c.login LIKE '%$busca%' OR c.nome_res LIKE '%$busca%')
    AND l.deltitulo = 0
    AND n.emissao BETWEEN '$data_inicial_sql' AND '$data_final_sql'
    AND l.status LIKE '$status_cap'
    $condicao_nfcom
";

$total_result = mysqli_query($link, $total_query);
$totais = mysqli_fetch_assoc($total_result);

$total_valor       = $totais['total_valor'];
$total_valor_pago  = $totais['total_valor_pago'];
$total_nfcom       = $totais['total_nfcom'];
$qtd_canceladas    = $totais['qtd_canceladas'];
$qtd_rejeitadas    = $totais['qtd_rejeitadas'];


$total_valor = $totais['total_valor']; 

mysqli_data_seek($result, 0);
while ($r = mysqli_fetch_array($result)) {
    $id_titulo   = $r['tit_id'];
    $valor_extra = $servicos_avulsos[$id_titulo] ?? 0;
    $total_valor += $valor_extra;
}
mysqli_data_seek($result, 0);
?>

