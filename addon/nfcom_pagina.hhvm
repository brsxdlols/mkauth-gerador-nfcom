if (strtolower($t_status) !== 'pago') {
    $valor_html = "<span style='background:#cfe2ff; color:#0d6efd; font-weight:600; padding:3px 10px; border-radius:8px;'>R$ $t_valor</span>";
    $valorpag_html = "<span style='background:#cfe2ff; color:#0d6efd; font-weight:600; padding:3px 10px; border-radius:8px;'>⏳ A receber</span>";
} else {
    $valor_html = "<span style='background:#cfe2ff; color:#0d6efd; font-weight:600; padding:3px 10px; border-radius:8px;'>R$ $t_valor</span>";
    $valorpag_html = "<span style='background:#d1e7dd; color:#0f5132; font-weight:600; padding:3px 10px; border-radius:8px;'>R$ $t_valorpag</span>";
}




    $nfcom_status = strtoupper(trim($row['nfcom_status']));
    $nfcom_emissao = $row['emissao'] ? date('d/m/Y', strtotime($row['emissao'])) : '';

    switch ($nfcom_status) {
